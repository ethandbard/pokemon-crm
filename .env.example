# ---------------------------------------------------------------------------
# Pokémon CRM — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Either set DATABASE_URL, or set the discrete PG* vars below. DATABASE_URL wins.
#
# Local development (Postgres on localhost):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pokemon_crm
#
# Azure Database for PostgreSQL — flexible server. SSL is required; set PGSSL=true.
# DATABASE_URL=postgres://<user>:<password>@<server>.postgres.database.azure.com:5432/pokemon_crm?sslmode=require

PGHOST=localhost
PGPORT=5432
PGDATABASE=pokemon_crm
PGUSER=postgres
PGPASSWORD=

# Set to "true" when pointing at Azure (or any server requiring TLS).
PGSSL=false

# --- API server -------------------------------------------------------------
PORT=4000

# Origin allowed by CORS. The Vite dev server runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173

# --- Seed script ------------------------------------------------------------
# Upper bound of the National Pokédex range to import from PokeAPI.
# 151 = Gen 1 only (fast), 1025 = everything through Gen 9 (slower).
SEED_LIMIT=1025

# Number of PokeAPI requests made in parallel. Keep this modest — PokeAPI is a
# free service and asks that clients be polite.
SEED_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Pokémon CRM — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Either set DATABASE_URL, or set the discrete PG* vars below. DATABASE_URL wins.
#
# Local development (Postgres on localhost):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pokemon_crm
#
# Azure Database for PostgreSQL — flexible server. SSL is required; set PGSSL=true.
# DATABASE_URL=postgres://<user>:<password>@<server>.postgres.database.azure.com:5432/pokemon_crm?sslmode=require

PGHOST=localhost
PGPORT=5432
PGDATABASE=pokemon_crm
PGUSER=postgres
PGPASSWORD=

# Set to "true" when pointing at Azure (or any server requiring TLS).
PGSSL=false

# --- API server -------------------------------------------------------------
# API_PORT wins over PORT. Keep it set for local dev: a dev harness that picks a
# free port for the web server does it by exporting PORT, and dotenv will not
# override a variable that is already set, so without this the API would bind
# the web server's port and the Vite proxy would find nothing on :4000.
# Leave API_PORT unset in production, where the platform supplies PORT.
API_PORT=4000
PORT=4000

# Origin allowed by CORS. The Vite dev server runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173

# --- Seed script ------------------------------------------------------------
# Upper bound of the National Pokédex range to import from PokeAPI.
# 151 = Gen 1 only (fast), 1025 = everything through Gen 9 (slower).
SEED_LIMIT=1025

# Number of PokeAPI requests made in parallel. Keep this modest — PokeAPI is a
# free service and asks that clients be polite.
SEED_CONCURRENCY=8

# Import moves. The species→move rows come free with the /pokemon responses;
# the move details are ~900 extra requests plus ~30 for version-group ordering.
# Set to false for a faster run — the moves pages then show their empty states.
SEED_MOVES=true

# Import ability effect text — one request per distinct ability the seeded dex
# references (284 on the full 1,025). Set to false and abilities render as their
# slugs, with no effect prose on the Profile.
SEED_ABILITIES=true

# Resolve TM/HM/TR numbers — one request per (move, game), ~2,400 for the full
# dex and the most expensive pass after the dex itself. Needs SEED_MOVES. With
# it off, movepool rows still say a move is machine-taught, just not which TM.
SEED_MACHINES=true
